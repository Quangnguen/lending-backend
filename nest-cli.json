{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      {
        "include": "i18n/**/*.json",
        "watchAssets": true
      },
      {
        "include": "static/**/*",
        "watchAssets": true
      },
      {
        "include": "views/**/*",
        "watchAssets": true
      }
    ],
    "watchAssets": true
  }
}
